# Local demo uses embedded PGlite and requires no credentials.
DATABASE_URL=
SESSION_SECRET=
CALLBACK_SIGNING_SECRET=
CRON_SECRET=
# Optional. AI is disabled unless explicitly configured; deterministic evidence summaries remain available.
AI_PROVIDER=disabled
AI_API_KEY=
# Optional AWS deployment settings. Never expose these to browser code.
AWS_REGION=ca-central-1
RISK_QUEUE_URL=
RESULTS_CALLBACK_URL=http://localhost:3000/api/internal/jobs/result
# Server-only, default off. Enable only for local role UAT; each login receives an isolated synthetic workspace.
DEMO_ACCOUNTS_ENABLED=false
# Optional for self-hosted container builds only. Leave unset for Vercel and `next start`.
NEXT_OUTPUT_MODE=
